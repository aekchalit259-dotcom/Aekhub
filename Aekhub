-- ระบบควบคุม Big Ball Toggle & Value
BBToggle.MouseButton1Click:Connect(function()
    Settings.BigBall = not Settings.BigBall
    if Settings.BigBall then
        BBToggle.Text = "Toggle: ON"
        BBToggle.TextColor3 = Color3.fromRGB(100, 255, 100)
    else
        BBToggle.Text = "Toggle: OFF"
        BBToggle.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end)

BBPlus.MouseButton1Click:Connect(function()
    if Settings.BigBallSizeValue < 10 then
        Settings.BigBallSizeValue = Settings.BigBallSizeValue + 1
        BBValLabel.Text = "Size: " .. Settings.BigBallSizeValue
    end
end)

BBMinus.MouseButton1Click:Connect(function()
    if Settings.BigBallSizeValue > 1 then
        Settings.BigBallSizeValue = Settings.BigBallSizeValue - 1
        BBValLabel.Text = "Size: " .. Settings.BigBallSizeValue
    end
end)

-- ระบบควบคุม Hitbox Toggle & Value
HBToggle.MouseButton1Click:Connect(function()
    Settings.Hitbox = not Settings.Hitbox
    if Settings.Hitbox then
        HBToggle.Text = "Toggle: ON"
        HBToggle.TextColor3 = Color3.fromRGB(100, 255, 100)
    else
        HBToggle.Text = "Toggle: OFF"
        HBToggle.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end)

HBPlus.MouseButton1Click:Connect(function()
    if Settings.HitboxMultiplier < 1.0 then
        Settings.HitboxMultiplier = math.clamp(Settings.HitboxMultiplier + 0.05, 0.01, 1.0)
        HBValLabel.Text = "Hitbox: " .. math.floor(Settings.HitboxMultiplier * 100) .. "%"
    end
end)

HBMinus.MouseButton1Click:Connect(function()
    if Settings.HitboxMultiplier > 0.01 then
        Settings.HitboxMultiplier = math.clamp(Settings.HitboxMultiplier - 0.05, 0.01, 1.0)
        HBValLabel.Text = "Hitbox: " .. math.floor(Settings.HitboxMultiplier * 100) .. "%"
    end
end)

-- ฟังก์ชันค้นหาลูกบอล
local function GetBall()
    return Workspace:FindFirstChild("Football") or Workspace:FindFirstChild("Ball")
end

-- การทำงานของ Big Ball ตามค่า Size 1-10
RunService.RenderStepped:Connect(function()
    local ball = GetBall()
    if ball and ball:IsA("BasePart") then
        if Settings.BigBall then
            -- คูณขนาดตามค่าระดับ 1 ถึง 10
            local scale = Settings.BigBallSizeValue * 1.5
            ball.Size = Vector3.new(scale, scale, scale)
            ball.CanCollide = false
        end
    end
end)

-- การทำงานของ Hitbox ตามค่าเปอร์เซ็นต์
RunService.Stepped:Connect(function()
    if Settings.Hitbox then
        local character = LocalPlayer.Character
        if character then
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if rootPart and rootPart:IsA("BasePart") then
                local baseSize = 2
                local extraSize = Settings.HitboxMultiplier * 15
                rootPart.Size = Vector3.new(baseSize + extraSize, baseSize + extraSize, baseSize + extraSize)
                rootPart.Transparency = 0.6
                rootPart.CanCollide = false
            end
        end
    end
end)
